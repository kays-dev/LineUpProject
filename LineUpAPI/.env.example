# =========================================================
#  LineUpAPI — modèle de configuration
#  Copier en .env (cp .env.example .env) puis remplir les valeurs.
#  Le .env n'est JAMAIS commité ; ce fichier-ci ne contient aucun vrai secret.
# =========================================================

# ===== Serveur =====
# 8080 par défaut ; éviter le port d'Apache (XAMPP)
APP_PORT=8080
#LOG_LEVEL=debug

# ===== Base de données (MySQL / MariaDB de XAMPP) =====
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=lineup

# ===== Authentification =====
# Chaîne longue et aléatoire, différente pour chaque environnement
# Générer : openssl rand -base64 32
#JWT_SECRET=change-me

# ===== Emails de confirmation (fournisseur à choisir) =====
#MAIL_FROM=no-reply@lineup.local
#MAIL_API_KEY=
