    "booking.success.message": {
      "comment": "Popup succès réservation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your booking for this workshop has been saved. We can't wait to welcome you!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réservation pour l'atelier a bien été enregistrée. Nous avons hâte de vous accueillir !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prenotazione per il laboratorio è stata registrata. Non vediamo l'ora di accoglierti!"
          }
        }
      }
    },
