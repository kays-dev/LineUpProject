          "stringUnit": {
            "state": "translated",
            "value": "You've joined the waitlist for this workshop. We'll let you know if a spot opens up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre inscription sur la liste d'attente est confirmée. Vous recevrez une notification si une place se libère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua iscrizione alla lista d'attesa è confermata. Riceverai una notifica se si libera un posto."
