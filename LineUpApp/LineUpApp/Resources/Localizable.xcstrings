    "cancel.booking.message %@ %@": {
      "comment": "%1$@ = code, %2$@ = nom de l'atelier",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Careful, this can't be undone: booking no. %1$@ for “%2$@” will be permanently cancelled and your spot released."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention, cette action est irréversible : votre réservation n° %1$@ pour « %2$@ » sera définitivement annulée et votre place libérée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione, questa azione è irreversibile: la prenotazione n° %1$@ per «%2$@» verrà annullata definitivamente e il tuo posto sarà liberato."
          }
        }
      }
    },
    "cancel.booking.title": {
      "comment": "Popup annulation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this booking?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la réservation ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare la prenotazione?"
          }
        }
      }
    },
    "cancel.confirm": {
      "comment": "Bouton popup annulation",
      "extractionState": "manual",
