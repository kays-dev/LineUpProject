    "tab.program": {
      "comment": "Onglet programme du festival",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StageUp"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartellone"
          }
        }
      }
    },
    "terms.1.text": {
      "comment": "Texte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These terms govern the use of the LineUp app, which lets you browse the festival programme and book activities."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les présentes conditions encadrent l'utilisation de l'application LineUp, qui permet de consulter le programme du festival et de réserver des activités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presenti condizioni regolano l'utilizzo dell'app LineUp, che permette di consultare il programma del festival e prenotare attività."
          }
        }
      }
    },
    "terms.1.title": {
      "comment": "Section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Purpose"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Objet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Oggetto"
          }
        }
      }
    },
    "terms.2.text": {
      "comment": "Texte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is personal. You are responsible for keeping your login details confidential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est personnel. Vous êtes responsable de la confidentialité de vos identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è personale. Sei responsabile della riservatezza delle tue credenziali."
          }
        }
      }
    },
    "terms.2.title": {
      "comment": "Section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Compte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Account"
          }
        }
      }
    },
    "terms.3.text": {
      "comment": "Texte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A booking is confirmed as soon as it appears in your agenda. As spots are limited, you may be offered a waitlist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réservation est confirmée dès qu'elle apparaît dans votre agenda. Les places étant limitées, une liste d'attente peut vous être proposée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una prenotazione è confermata appena compare nella tua agenda. Poiché i posti sono limitati, potrebbe esserti proposta una lista d'attesa."
          }
        }
      }
    },
    "terms.3.title": {
      "comment": "Section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Bookings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Réservations"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Prenotazioni"
          }
        }
      }
    },
    "terms.4.text": {
      "comment": "Texte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel a booking from your agenda until the activity starts. Cancellation is immediate and final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez annuler une réservation depuis votre agenda jusqu'au début de l'activité. L'annulation est immédiate et définitive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare una prenotazione dalla tua agenda fino all'inizio dell'attività. L'annullamento è immediato e definitivo."
          }
        }
      }
    },
    "terms.4.title": {
      "comment": "Section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Cancellation"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Annulation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Annullamento"
          }
        }
      }
    },
    "terms.5.text": {
      "comment": "Texte",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules may change. The festival team will notify you of any change."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires peuvent évoluer. L'équipe du festival vous prévient de tout changement par notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari possono cambiare. Lo staff del festival ti avviserà di ogni modifica tramite notifica."
          }
        }
      }
    },
    "terms.5.title": {
      "comment": "Section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Changes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Modifications"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Modifiche"
          }
        }
      }
    },
    "terms.title": {
      "comment": "Titre",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termini"
          }
        }
      }
    },
