# =========================================================
#  LineUpApp — App iOS (SwiftUI / Xcode)
# =========================================================

# ===== macOS =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ===== Xcode : fichiers propres à CHAQUE développeur =====
# (position des fenêtres, breakpoints perso, schemes non partagés…)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.mode1v3
*.mode2v3
*.perspectivev3
*.pbxuser
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# ===== Xcode : à PARTAGER avec l'équipe (ne pas ignorer) =====
# - *.xcodeproj/project.pbxproj           → structure du projet
# - *.xcodeproj/xcshareddata/xcschemes/   → schemes cochés "Shared"
# - *.xcworkspace/contents.xcworkspacedata
# - xcshareddata/IDEWorkspaceChecks.plist
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
!**/xcshareddata/IDEWorkspaceChecks.plist

# ===== Build & produits générés =====
DerivedData/
build/
Index/
*.moved-aside
*.hmap
*.ipa
*.app
*.xcarchive
*.dSYM
*.dSYM.zip

